{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "summary", "requirements", "tests", "blocking_issues", "manual_checks"],
  "properties": {
    "decision": {"type": "string", "enum": ["pass", "fail", "manual_required"]},
    "summary": {"type": "string"},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "evidence"],
        "properties": {
          "name": {"type": "string"},
          "status": {"type": "string", "enum": ["pass", "fail", "manual_required"]},
          "evidence": {"type": "string"}
        }
      }
    },
    "tests": {"type": "array", "items": {"type": "string"}},
    "blocking_issues": {"type": "array", "items": {"type": "string"}},
    "manual_checks": {"type": "array", "items": {"type": "string"}}
  }
}
