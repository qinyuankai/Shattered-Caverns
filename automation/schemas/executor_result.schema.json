{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "changed_files", "tests", "manual_checks", "risks", "suggested_commit_message"],
  "properties": {
    "status": {"type": "string", "enum": ["completed", "blocked", "failed"]},
    "summary": {"type": "string"},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "result"],
        "properties": {
          "command": {"type": "string"},
          "exit_code": {"type": "integer"},
          "result": {"type": "string"}
        }
      }
    },
    "manual_checks": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "suggested_commit_message": {"type": "string"}
  }
}
